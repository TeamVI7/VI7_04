--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 43129b57210751f44b8695eb34d4b9c7, type: 3}
  m_Name: Morse
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  lines:
  - speaker: "\u0110\u1EA1i \xDAy. Harsh"
    text: "B\xE1o c\xE1o t\xECnh h\xECnh. C\xE1nh c\u1EEDa ph\xEDa tr\u01B0\u1EDBc
      m\u1EB7t \u0111\xE3 b\u1ECB kh\xF3a. H\xE3y gi\u1EEF b\xECnh t\u0129nh v\xE0
      quan s\xE1t k\u1EF9 m\xF4i tr\u01B0\u1EDDng xung quanh."
    portrait: {fileID: 21300000, guid: 4e720ec10f0df474eadb80653e04e8a3, type: 3}
    voiceClip: {fileID: 0}
    duration: 5
  - speaker: "\u0110\u1EA1i \xDAy. Harsh"
    text: "Ph\xEDa tr\xEAn khung c\u1EEDa, b\u1EA1n s\u1EBD th\u1EA5y b\u1ED1n \u0111\xE8n
      t\xEDn hi\u1EC7u \u0111ang nh\u1EA5p nh\xE1y. \u0110\xF3 kh\xF4ng ph\u1EA3i
      l\xE0 s\u1EF1 c\u1ED1 c\u01A1 s\u1EDF h\u1EA1 t\u1EA7ng. H\u1EC7 th\u1ED1ng
      \u0111ang ch\u1EE7 \u0111\u1ED9ng ph\xE1t t\xEDn hi\u1EC7u m\xE3 Morse theo
      m\u1ED9t chu k\u1EF3 tu\u1EA7n ho\xE0n."
    portrait: {fileID: 21300000, guid: 4e720ec10f0df474eadb80653e04e8a3, type: 3}
    voiceClip: {fileID: 0}
    duration: 7
  - speaker: "\u0110\u1EA1i \xDAy. Harsh"
    text: "Ti\u1EBFp theo, h\xE3y ki\u1EC3m tra thi\u1EBFt b\u1ECB \u0111\u1EA7u
      cu\u1ED1i \u1EDF b\xEAn ph\u1EA3i. Tr\u1EA1m m\xE1y t\xEDnh n\xE0y \u0111ang
      \u1EDF tr\u1EA1ng th\xE1i ch\u1EDD v\xE0 y\xEAu c\u1EA7u m\u1ED9t chu\u1ED7i
      m\u1EADt m\xE3 \u0111\u1EC3 c\u1EA5p quy\u1EC1n truy c\u1EADp. "
    portrait: {fileID: 21300000, guid: 4e720ec10f0df474eadb80653e04e8a3, type: 3}
    voiceClip: {fileID: 0}
    duration: 7
  - speaker: "\u0110\u1EA1i \xDAy. Harsh"
    text: "D\u1EEF li\u1EC7u t\u1EEB b\u1ED1n \u0111\xE8n t\xEDn hi\u1EC7u kia ch\xEDnh
      l\xE0 m\xE3 kh\xF3a m\xE0 b\u1EA1n c\u1EA7n tr\xEDch xu\u1EA5t.\n\u0110\u1EC3
      gi\u1EA3i m\xE3, h\xE3y ti\u1EBFn h\xE0nh r\xE0 so\xE1t khu v\u1EF1c hi\u1EC7n
      t\u1EA1i. "
    portrait: {fileID: 21300000, guid: 4e720ec10f0df474eadb80653e04e8a3, type: 3}
    voiceClip: {fileID: 0}
    duration: 7
  - speaker: "\u0110\u1EA1i \xDAy. Harsh"
    text: "T\xECm m\u1ED9t t\u1EADp t\xE0i li\u1EC7u \u0111\u01B0\u1EE3c d\xE1n nh\xE3n
      'H\u01B0\u1EDBng d\u1EABn v\u1EADn h\xE0nh t\xEAn l\u1EEDa'. \u0110\xF3 ch\u1EC9
      l\xE0 v\u1ECF b\u1ECDc th\xF4ng tin. B\xEAn trong t\xE0i li\u1EC7u \u0111\xF3
      \u0111\u01B0\u1EE3c k\u1EB9p m\u1ED9t b\u1EA3ng \u0111\u1ED1i chi\u1EBFu m\xE3
      Morse ti\xEAu chu\u1EA9n. "
    portrait: {fileID: 21300000, guid: 4e720ec10f0df474eadb80653e04e8a3, type: 3}
    voiceClip: {fileID: 0}
    duration: 5
  - speaker: "\u0110\u1EA1i \xDAy. Harsh"
    text: "H\xE3y thu th\u1EADp b\u1EA3ng m\xE3, d\u1ECBch chu\u1ED7i t\xEDn hi\u1EC7u
      \u0111\xE8n, nh\u1EADp th\xF4ng tin v\xE0o thi\u1EBFt b\u1ECB \u0111\u1EA7u
      cu\u1ED1i v\xE0 ti\u1EBFp t\u1EE5c nhi\u1EC7m v\u1EE5. H\u1EBFt. "
    portrait: {fileID: 21300000, guid: 4e720ec10f0df474eadb80653e04e8a3, type: 3}
    voiceClip: {fileID: 0}
    duration: 4
  fullVoiceClip: {fileID: 8300000, guid: 821848e325c46334980d747cb7cb751e, type: 3}
  autoPlay: 1
  autoPlayDelay: 5
